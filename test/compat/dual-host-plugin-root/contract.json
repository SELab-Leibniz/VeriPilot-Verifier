{
  "identifier": "dual-host-plugin-root",
  "extends": "claude-plugin-core-hooks-json-stdio",
  "environment": [
    "CLAUDE_PLUGIN_ROOT",
    "CODEAGENT3_PLUGIN_ROOT"
  ],
  "conflictPolicy": "canonical-roots-must-match",
