{
  "description": "Run project-configured artifact, Skill, Ground Truth, and terminal correction.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime-event.mjs\"",
            "timeout": 30,
            "statusMessage": "Runtime Corrector is validating and recovering local state..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime-event.mjs\"",
            "timeout": 1800,
            "statusMessage": "Runtime Corrector is reconciling the current task state..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Bash|PowerShell|Write|Edit|NotebookEdit|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime-event.mjs\"",
            "timeout": 1260,
            "statusMessage": "Runtime Corrector is establishing the task baseline before the first correction-relevant action..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-use.mjs\"",
            "timeout": 1260,
            "statusMessage": "Runtime Corrector is reconciling task state and reviewing matching artifacts..."
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/evidence-distinctness-guard.mjs\"",
            "timeout": 30,
            "statusMessage": "Runtime Corrector is checking that named evidence files are distinct..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime-event.mjs\"",
            "timeout": 3000,
            "statusMessage": "Runtime Corrector is evaluating the completed stage or task..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/runtime-event.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.mjs\"",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
