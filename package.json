{
  "name": "runtime-corrector",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "description": "Explainable, project-configured runtime correction for artifact workflows.",
  "bin": {
    "runtime-corrector": "./scripts/cli.mjs"
  },
  "scripts": {
    "baseline": "node ./scripts/run-baseline.mjs",
    "test:baseline": "node --test test/baseline-run.test.mjs test/native-baseline-component.test.mjs test/baseline-coverage-audit.test.mjs test/stop-baseline-task.test.mjs",
    "check": "node ./scripts/cli.mjs",
    "build:plugin": "node ./scripts/build-plugin.mjs",
    "build:plugins": "node ./scripts/build-plugin.mjs --all",
    "build:ma": "node ./scripts/build-ma-plugin.mjs",
    "test:ma": "node --test test/ma-market-package.test.mjs test/ma-market-lifecycle.test.mjs test/ma-market-host.test.mjs",
    "test:artifacts": "node --test test/plugin-artifacts.test.mjs test/stop-task-package.test.mjs",
    "test": "node ./scripts/test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
