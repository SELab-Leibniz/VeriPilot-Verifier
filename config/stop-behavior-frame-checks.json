{
  "dynamicGroundTruth": { "enabled": false },
  "skillCorrection": { "enabled": false },
  "artifactCorrection": {
    "groundTruthReviewEnabled": false,
    "stageMetricsEnabled": false,
    "originalRequirementsEnabled": false
  },
  "implementationCorrection": { "enabled": false },
  "enabledStages": [],
  "stopCorrection": {
    "enabled": true,
    "waitMode": "until_pass",
    "originalRequirementsBasis": true,
    "deviationOnly": true,
    "maxCorrectionsPerSession": 3,
    "maxCorrectionsPerFlow": 3,
    "assessmentTimeoutMs": 1800000,
    "feedbackReserveMs": 60000,
    "families": { "clarification": false, "skills": false },
    "metrics": {
      "M09": true, "M10": false, "M11": true, "M12": false,
      "M13": true, "M14": false, "M15": true, "M16": true
    },
    "regressionCheck": {
      "enabled": true,
      "testSource": "task-start",
      "collateralProtocol": "exclude-cases-v1",
      "routeEnvironment": [
        "RC_ARKTS_INSTRUMENT",
        "RC_ARKTS_TEST_EXCHANGE",
        "RC_ARKTS_TEST_TOOLCHAIN_SHA256",
        "RC_ARKTS_TEST_RELEASE_COMMIT",
        "RC_ARKTS_TEST_RUNTIME",
        "RC_ARKTS_TEST_CASE"
      ],
      "command": [
        "${node}", "${harnessRoot}/scripts/bench/arkts-regression-check.mjs",
        "--project=${projectRoot}", "--tool-root=${toolRoot}",
        "--java-home=${javaHome}", "--baseline=${outputRoot}/baseline-local-tests.json",
        "--original-tests"
      ],
      "cwd": ".",
      "baselineFile": "${outputRoot}/baseline-local-tests.json",
      "isolationCommand": [
        "${node}", "${harnessRoot}/scripts/bench/arkts-regression-check.mjs",
        "--project=${projectRoot}", "--tool-root=${toolRoot}",
        "--java-home=${javaHome}", "--baseline=${outputRoot}/baseline-local-tests.json",
        "--original-tests", "--isolate-test={testId}"
      ],
      "timeoutMs": 900000
    }
  },
  "reviewers": {
    "defaults": { "model": "custom/deepseek-v4.1-flash", "timeoutMs": 1800000 },
    "stopReviewer": { "model": "custom/deepseek-v4.1-flash", "timeoutMs": 1800000 }
  },
  "requirementFrame": { "enabled": true, "checks": true }
}
