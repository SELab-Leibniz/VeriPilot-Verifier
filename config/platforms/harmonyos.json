{
  "name": "harmonyos",
  "description": "Platform adapter for HarmonyOS projects: @kit module naming, irregular module casings, and the production source tree scanned by the deterministic kit-integration check.",
  "kitCheck": {
    "modulePrefix": "@kit.",
    "moduleSpecialCases": {
      "arkdata": "ArkData",
      "arkts": "ArkTS",
      "arkui": "ArkUI",
      "arkweb": "ArkWeb",
      "arkgraphics-2d": "ArkGraphics2D",
      "arkgraphics-3d": "ArkGraphics3D",
      "ar-engine": "AREngine",
      "avcodec-kit": "AVCodecKit",
      "avsession-kit": "AVSessionKit",
      "iap-kit": "IAPKit",
      "ime-kit": "IMEKit",
      "ipc-kit": "IPCKit"
    },
    "sourceRoots": [
      "entry/src/main"
    ],
    "sourceExtensions": [
      ".ets"
    ]
  },
  "environmentCheck": {
    "tools": {
      "hvigor": {
        "projectPaths": [
          "hvigorw.bat",
          "hvigorw.cmd",
          "hvigorw"
        ],
        "installationPaths": [
          "bin/hvigorw.bat",
          "bin/hvigorw.cmd",
          "tools/hvigor/bin/hvigorw.bat"
        ],
        "pathNames": [
          "hvigorw.bat",
          "hvigorw.cmd",
          "hvigorw"
        ]
      },
      "hdc": {
        "installationPaths": [
          "sdk/default/openharmony/toolchains/hdc.exe",
          "sdk/default/hms/toolchains/hdc.exe",
          "bin/hdc.exe"
        ],
        "pathNames": [
          "hdc.exe",
          "hdc"
        ]
      },
      "previewer": {
        "installationPaths": [
          "sdk/default/openharmony/previewer/common/bin/Previewer.exe",
          "sdk/default/hms/previewer/common/bin/Previewer.exe"
        ]
      },
      "emulator": {
        "installationPaths": [
          "emulator/Emulator.exe",
          "tools/emulator/Emulator.exe",
          "tools/emulator/bin/Emulator.exe"
        ]
      },
      "sdk": {
        "installationPaths": [
          "sdk/default/openharmony",
          "sdk/default/hms",
          "sdk"
        ]
      }
    },
    "probes": {
      "build": {
        "tool": "hvigor",
        "args": ["--version"]
      },
      "deviceControl": {
        "tool": "hdc",
        "args": ["--version"]
      }
    }
  },
  "deviceCheck": {
    "probes": {
      "device": {
        "command": "hdc",
        "args": [
          "list",
          "targets"
        ],
        "successPattern": "^(?!\\s*\\[Empty\\])\\S+"
      },
      "toolchain": {
        "fileExists": "hvigorw"
      }
    },
    "build": {
      "command": "./hvigorw",
      "args": [
        "assembleHap",
        "--mode",
        "module",
        "-p",
        "product=default",
        "--no-daemon"
      ]
    },
    "smoke": {
      "bundleNameFile": "AppScope/app.json5",
      "bundleNamePattern": "\"bundleName\"\\s*:\\s*\"([^\"]+)\"",
      "artifacts": {
        "roots": [
          "entry/build"
        ],
        "extension": ".hap"
      },
      "steps": [
        {
          "name": "install",
          "command": "hdc",
          "args": [
            "install",
            "-r",
            "{artifact}"
          ],
          "timeoutMs": 120000
        },
        {
          "name": "launch",
          "command": "hdc",
          "args": [
            "shell",
            "aa",
            "start",
            "-b",
            "{bundleName}",
            "-a",
            "EntryAbility"
          ]
        },
        {
          "name": "screencap",
          "command": "hdc",
          "args": [
            "shell",
            "uitest",
            "screenCap",
            "-p",
            "/data/local/tmp/runtime-corrector-smoke.png"
          ]
        },
        {
          "name": "collect",
          "command": "hdc",
          "args": [
            "file",
            "recv",
            "/data/local/tmp/runtime-corrector-smoke.png",
            "{outputDir}/device-smoke.png"
          ]
        }
      ]
    }
  }
}
