{
  "name": "harmonyos",
  "description": "Platform adapter for HarmonyOS projects: @kit module naming, irregular module casings, and the production source tree scanned by the deterministic kit-integration check.",
  "kitCheck": {
    "modulePrefix": "@kit.",
    "moduleSpecialCases": {
      "arkdata": "ArkData",
      "arkts": "ArkTS",
      "arkui": "ArkUI",
      "arkweb": "ArkWeb",
      "arkgraphics-2d": "ArkGraphics2D",
      "arkgraphics-3d": "ArkGraphics3D",
      "ar-engine": "AREngine",
      "avcodec-kit": "AVCodecKit",
      "avsession-kit": "AVSessionKit",
      "iap-kit": "IAPKit",
      "ime-kit": "IMEKit",
      "ipc-kit": "IPCKit"
    },
    "sourceRoots": [
      "entry/src/main"
    ],
    "sourceExtensions": [
      ".ets"
    ],
    "catalog": [
      "ability-kit",
      "accessibility-kit",
      "account-kit",
      "ads-kit",
      "agent-framework-kit",
      "app-linking-kit",
      "appgallery-kit",
      "ar-engine",
      "arkdata",
      "arkgraphics-2d",
      "arkgraphics-3d",
      "arkts",
      "arkui",
      "arkweb",
      "asset-store-kit",
      "audio-kit",
      "avcodec-kit",
      "avsession-kit",
      "background-tasks-kit",
      "basic-services-kit",
      "calendar-kit",
      "call-service-kit",
      "camera-kit",
      "cann-kit",
      "car-kit",
      "cloud-foundation-kit",
      "connectivity-kit",
      "contacts-kit",
      "core-file-kit",
      "core-speech-kit",
      "core-vision-kit",
      "crypto-architecture-kit",
      "data-augmentation-kit",
      "data-protection-kit",
      "desktop-extension-kit",
      "device-certificate-kit",
      "device-security-kit",
      "distributed-service-kit",
      "driver-development-kit",
      "drm-kit",
      "enterprise-data-guard-kit",
      "enterprise-space-kit",
      "fast-kit",
      "file-manager-service-kit",
      "form-kit",
      "function-flow-runtime-kit",
      "game-controller-kit",
      "game-service-kit",
      "graphics-accelerate-kit",
      "health-service-kit",
      "iap-kit",
      "image-kit",
      "ime-kit",
      "input-kit",
      "intents-kit",
      "ipc-kit",
      "live-view-kit",
      "localization-kit",
      "location-kit",
      "map-kit",
      "mdm-kit",
      "mechanic-kit",
      "media-kit",
      "media-library-kit",
      "mindspore-lite-kit",
      "multimodal-awareness-kit",
      "natural-language-kit",
      "nearlink-kit",
      "network-boost-kit",
      "network-kit",
      "neural-network-runtime-kit",
      "notification-kit",
      "online-authentication-kit",
      "payment-kit",
      "pdf-kit",
      "pen-kit",
      "performance-analysis-kit",
      "preview-kit",
      "push-kit",
      "reader-kit",
      "remote-communication-kit",
      "ringtone-kit",
      "scan-kit",
      "scenario-fusion-kit",
      "screen-time-guard-kit",
      "sensor-service-kit",
      "service-collaboration-kit",
      "share-kit",
      "spatial-recon-kit",
      "speech-kit",
      "telephony-kit",
      "test-kit",
      "ui-design-kit",
      "universal-keystore-kit",
      "user-authentication-kit",
      "vision-kit",
      "wallet-kit",
      "wear-engine-kit",
      "weather-service-kit",
      "xengine-kit"
    ],
    "catalogNote": "Known capability names for this platform. Used ONLY to validate names, never to generate them: a capability the platform does not have cannot become a blocking obligation. Unknown names are kept as review-only (catalogUnmatched)."
  },
  "deviceCheck": {
    "probes": {
      "device": {
        "command": "hdc",
        "args": [
          "list",
          "targets"
        ],
        "successPattern": "^(?!\\s*\\[Empty\\])\\S+"
      },
      "toolchain": {
        "fileExists": "hvigorw"
      }
    },
    "build": {
      "command": "./hvigorw",
      "args": [
        "assembleHap",
        "--mode",
        "module",
        "-p",
        "product=default",
        "--no-daemon"
      ]
    },
    "smoke": {
      "bundleNameFile": "AppScope/app.json5",
      "bundleNamePattern": "\"bundleName\"\\s*:\\s*\"([^\"]+)\"",
      "artifacts": {
        "roots": [
          "entry/build"
        ],
        "extension": ".hap"
      },
      "steps": [
        {
          "name": "install",
          "command": "hdc",
          "args": [
            "install",
            "-r",
            "{artifact}"
          ],
          "timeoutMs": 120000
        },
        {
          "name": "launch",
          "command": "hdc",
          "args": [
            "shell",
            "aa",
            "start",
            "-b",
            "{bundleName}",
            "-a",
            "EntryAbility"
          ]
        },
        {
          "name": "screencap",
          "command": "hdc",
          "args": [
            "shell",
            "uitest",
            "screenCap",
            "-p",
            "/data/local/tmp/runtime-corrector-smoke.png"
          ]
        },
        {
          "name": "collect",
          "command": "hdc",
          "args": [
            "file",
            "recv",
            "/data/local/tmp/runtime-corrector-smoke.png",
            "{outputDir}/device-smoke.png"
          ]
        }
      ]
    }
  },
  "sourceManifest": {
    "roots": [
      "entry/src/main",
      "AppScope"
    ],
    "files": [
      "oh-package.json5",
      "build-profile.json5",
      "entry/build-profile.json5",
      "entry/oh-package.json5"
    ],
    "extensions": [
      ".ets",
      ".ts",
      ".js",
      ".json",
      ".json5",
      ".yaml",
      ".yml",
      ".ts5"
    ],
    "excludedDirectories": [
      ".hvigor",
      ".preview",
      "build",
      "oh_modules",
      "ohosTest"
    ]
  }
}
