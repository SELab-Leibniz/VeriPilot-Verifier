{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guarded-delivery/prd/universal-handoff.schema.json",
  "title": "Verified PRD to Build QA universal handoff",
  "type": "object",
  "required": [
    "schema_version",
    "schema_revision",
    "request_id",
    "workspace_id",
    "producer",
    "status",
    "artifacts",
    "domain_payload",
    "handoff_hash"
  ],
  "properties": {
    "schema_version": { "const": "veripilot.handoff.v2" },
    "schema_revision": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "producer": {
      "type": "object",
      "required": ["stage_id", "component_id"],
      "properties": {
        "stage_id": { "const": "40-prd-contract" },
        "component_id": { "const": "prd-contract" }
      },
      "additionalProperties": true
    },
    "status": { "const": "verified" },
    "artifacts": { "type": "array", "minItems": 3 },
    "domain_payload": {
      "type": "object",
      "required": ["schema_version", "value"],
      "properties": {
        "schema_version": { "const": "build_qa_loop.prd_handoff.v1" },
        "value": {
          "type": "object",
          "required": [
            "schema_version",
            "source",
            "artifacts",
            "milestones",
            "previous_results",
            "policy",
            "handoff_hash"
          ],
          "properties": {
            "schema_version": { "const": "build_qa_loop.prd_handoff.v1" },
            "source": {
              "type": "object",
              "required": ["stage_id", "status", "stale"],
              "properties": {
                "stage_id": { "const": "40-prd-contract" },
                "status": { "type": "string", "minLength": 1 },
                "stale": { "const": false }
              },
              "additionalProperties": true
            },
            "artifacts": { "type": "object", "additionalProperties": true },
            "milestones": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "sr_ids",
                  "depends_on",
                  "target_files",
                  "acceptance_refs",
                  "prdcheck_marks",
                  "status"
                ],
                "properties": {
                  "id": { "type": "string", "pattern": "^M[1-9][0-9]{0,2}$" },
                  "title": { "type": "string", "minLength": 1 },
                  "sr_ids": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^SR-[1-9][0-9]*$" }
                  },
                  "depends_on": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^M[1-9][0-9]{0,2}$" }
                  },
                  "target_files": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "acceptance_refs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "prdcheck_marks": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]*_OK$"
                    }
                  },
                  "status": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            },
            "previous_results": { "type": "array" },
            "policy": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": { "const": "auto" },
                "max_attempts": { "type": "integer", "minimum": 1 },
                "max_qa_returns": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            },
            "handoff_hash": {
              "type": "string",
              "pattern": "^sha256:[a-fA-F0-9]{64}$"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "handoff_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  },
  "additionalProperties": true
}
