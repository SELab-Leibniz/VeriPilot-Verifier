{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guarded-delivery/stage-completion.schema.json",
  "title": "Guarded Delivery stage completion report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "status",
    "terminal",
    "attempts",
    "inputs",
    "outputs",
    "corrector",
    "component_result",
    "gate",
    "blockers",
    "human_approval_recorded",
    "next_stage",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "guarded_delivery.stage_completion.v1"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "stage": {
      "type": "object",
      "required": ["name", "order", "title"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["completed", "needs_human", "blocked", "not_run"]
    },
    "terminal": { "const": true },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "round",
          "outcome",
          "corrector_status",
          "component_status",
          "diagnostic_refs"
        ],
        "properties": {
          "round": { "type": "integer", "minimum": 0 },
          "outcome": {
            "type": "string",
            "enum": ["completed", "needs_correction", "needs_human", "blocked", "not_run"]
          },
          "corrector_status": {
            "type": "string",
            "enum": ["not_required", "passed", "pending", "warning", "failed"]
          },
          "component_status": {
            "type": "string",
            "enum": ["not_required", "verified", "needs_human", "blocked", "not_run"]
          },
          "diagnostic_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256", "authority"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "authority": { "const": "read_only" }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "corrector": {
      "type": "object",
      "required": [
        "required",
        "status",
        "node",
        "bundle_complete",
        "agent_review_status",
        "incoming_edges",
        "rounds",
        "diagnostic_paths"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["not_required", "passed", "pending", "warning", "failed"]
        },
        "node": { "type": "string", "minLength": 1 },
        "bundle_complete": { "type": "boolean" },
        "agent_review_status": {
          "type": "string",
          "enum": ["not_required", "requested", "completed", "failed"]
        },
        "incoming_edges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rounds": { "type": "integer", "minimum": 0 },
        "diagnostic_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "component_result": {
      "type": "object",
      "required": [
        "component_id",
        "mode",
        "public_status",
        "completion_summary"
      ],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["auto", "not_required"] },
        "public_status": {
          "type": "string",
          "enum": ["not_required", "verified", "needs_human", "blocked", "not_run"]
        },
        "manifest_path": { "type": "string", "minLength": 1 },
        "manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "completion_summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["required_checks", "result"],
      "properties": {
        "required_checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "result": {
          "type": "string",
          "enum": ["passed", "needs_human", "blocked", "not_run"]
        }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "evidence_refs", "retryable", "owner"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "retryable": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "human_approval_recorded": { "type": "boolean" },
    "next_stage": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
