{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guarded-delivery/planning/relations.schema.json",
  "title": "Guarded delivery Planning relations",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "planning.relations.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^(SR-[1-9][0-9]*|M[1-9][0-9]*)$" },
          "type": { "type": "string", "enum": ["sr", "milestone"] },
          "title": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string", "pattern": "^(SR-[1-9][0-9]*|M[1-9][0-9]*)$" },
          "to": { "type": "string", "pattern": "^(SR-[1-9][0-9]*|M[1-9][0-9]*)$" },
          "type": { "type": "string", "enum": ["contains", "requires"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
