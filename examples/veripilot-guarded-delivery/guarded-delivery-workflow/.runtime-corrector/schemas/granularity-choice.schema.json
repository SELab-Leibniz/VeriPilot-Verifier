{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guarded-delivery/planning/granularity-choice.schema.json",
  "title": "Guarded delivery Planning granularity choice",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "selected",
    "recommended",
    "milestone_count",
    "groups",
    "source",
    "reason"
  ],
  "properties": {
    "schema_version": { "const": "planning.granularity_choice.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["user", "auto"] },
    "selected": { "type": "string", "enum": ["coarse", "normal", "fine"] },
    "recommended": { "type": "string", "enum": ["coarse", "normal", "fine"] },
    "milestone_count": { "type": "integer", "minimum": 1 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["milestone", "sr_ids"],
        "properties": {
          "milestone": { "type": "string", "pattern": "^M[1-9][0-9]*$" },
          "sr_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SR-[1-9][0-9]*$" }
          }
        },
        "additionalProperties": false
      }
    },
    "source": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "planning_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "sr_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "pilot_plan_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "relations_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "files": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "hashes_omitted_reason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
