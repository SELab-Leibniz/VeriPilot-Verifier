{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guarded-delivery/prd/acceptance-contract.schema.json",
  "title": "PRD acceptance contract",
  "type": "object",
  "required": ["schema_version", "stage_id", "status", "prd_hash", "items"],
  "properties": {
    "schema_version": { "const": "prd_contract.acceptance.v1" },
    "stage_id": { "const": "40-prd-contract" },
    "status": { "type": "string", "enum": ["reviewed", "auto_ready", "verified"] },
    "prd_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sr_id", "acceptance_refs"],
        "properties": {
          "sr_id": { "type": "string", "pattern": "^SR-[1-9][0-9]*$" },
          "acceptance_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
