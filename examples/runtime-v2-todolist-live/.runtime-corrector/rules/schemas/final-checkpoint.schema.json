{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "status", "testCommand", "testEvidence", "requirements", "criticalJourney"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
    "testCommand": { "const": "npm test" },
    "testEvidence": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^R0[1-9]$" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "criticalJourney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": { "const": "R09" },
        "status": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
